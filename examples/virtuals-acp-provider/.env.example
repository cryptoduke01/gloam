# ACP agent wallet (Privy-managed; from the Virtuals dashboard). The signer is a
# Privy authorization key (starts with MIGH), not an EOA private key.
SELLER_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
SELLER_WALLET_ID=00000000-0000-0000-0000-000000000000
SELLER_SIGNER_PRIVATE_KEY=MIGH...

# Testnet by default (ACP on Base Sepolia, Gloam's Base Sepolia vault).
# For mainnet: ACP_MAINNET=1, ACP_CHAIN_ID=4663 and GLOAM_NETWORK=robinhood-mainnet.
GLOAM_NETWORK=base
# ACP_MAINNET=1
# ACP_CHAIN_ID=4663

# The note store key (32 random bytes in hex: openssl rand -hex 32). Required here,
# since the ACP wallet has no local key to derive one from. Back it up.
GLOAM_NOTE_KEY=
GLOAM_AGENT_ID=private-payout
# Per-asset limits; without this file, limits.example.json is used.
# GLOAM_LIMITS_FILE=./limits.json
