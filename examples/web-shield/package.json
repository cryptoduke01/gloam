{
  "name": "gloam-web-shield-example",
  "private": true,
  "type": "module",
  "description": "Reference wrapper: shield a private balance in the browser with @gloamtrade/sdk.",
  "scripts": {
    "artifacts": "mkdir -p public/circuits && cp ../../app/public/circuits/shield.wasm ../../app/public/circuits/shield_final.zkey public/circuits/",
    "predev": "npm run artifacts",
    "prebuild": "npm run artifacts",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start"
  },
  "dependencies": {
    "@gloamtrade/sdk": "workspace:*",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "snarkjs": "0.7.5",
    "viem": "^2.31.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
