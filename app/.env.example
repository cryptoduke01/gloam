# ── Optional overrides only ──────────────────────────────────────────
# App defaults are hard-coded for Robinhood testnet (46630):
#   Poseidon pool (sealed) 0x4F38…2D8F @ block 90436718
#   GloamPayMemo           0x689e…5DCE @ block 90421567
#
# You do NOT need these on Vercel for testnet to work.
# Set only if you redeploy contracts or point at a fork.

# NEXT_PUBLIC_POSEIDON_SHIELD_POOL=0x4F38a4d80e5ca516A2e5549404C7be0E91c12D8F
# NEXT_PUBLIC_HASH_SCHEME=poseidon
# NEXT_PUBLIC_SHIELD_DEPLOY_BLOCK=90436718
# NEXT_PUBLIC_PAY_MEMO=0x689ebd9d30E0235c73fd8f10236F850CDB3c5DCE
# NEXT_PUBLIC_PAY_MEMO_DEPLOY_BLOCK=90421567

# Legacy keccak pool:
# NEXT_PUBLIC_HASH_SCHEME=keccak
# NEXT_PUBLIC_SHIELD_POOL_ADDRESS=0x2BD98196D90AB45D58843B4c8B8809aa34343d35

# ── Public testnet open gate ─────────────────────────────────────────
# Default in code: 2026-07-16T14:00:00+01:00 (2pm Nigeria / WAT).
# NEXT_PUBLIC_TESTNET_OPENS_AT=2026-07-16T14:00:00+01:00
# Force open immediately:
# NEXT_PUBLIC_TESTNET_FORCE_OPEN=true
# Founder early access: https://gloam.trade/app?early=YOUR_SECRET
# NEXT_PUBLIC_TESTNET_EARLY_KEY=your-secret-here

# Optional: Discord/Slack/Make webhook for product events (server only)
# TRACTION_WEBHOOK_URL=https://discord.com/api/webhooks/...
