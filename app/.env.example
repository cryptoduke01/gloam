# ── Optional overrides only ──────────────────────────────────────────
# App defaults are hard-coded for Robinhood testnet (46630):
#   Poseidon pool (sealed) 0x4F38…2D8F @ block 90436718
#   GloamPayMemo           0x689e…5DCE @ block 90421567
#
# You do NOT need these on Vercel for testnet to work.
# Set only if you redeploy contracts or point at a fork.
#
# DO NOT set NEXT_PUBLIC_POSEIDON_SHIELD_POOL to 0xA488… (pre-sealed vault).
# The app remaps that stale address to 0x4F38… automatically.

# NEXT_PUBLIC_POSEIDON_SHIELD_POOL=0x4F38a4d80e5ca516A2e5549404C7be0E91c12D8F
# NEXT_PUBLIC_HASH_SCHEME=poseidon
# NEXT_PUBLIC_SHIELD_DEPLOY_BLOCK=90436718
# NEXT_PUBLIC_PAY_MEMO=0x689ebd9d30E0235c73fd8f10236F850CDB3c5DCE
# NEXT_PUBLIC_PAY_MEMO_DEPLOY_BLOCK=90421567

# Legacy keccak pool (no private trade):
# NEXT_PUBLIC_HASH_SCHEME=keccak
# NEXT_PUBLIC_SHIELD_POOL_ADDRESS=0x2BD98196D90AB45D58843B4c8B8809aa34343d35

# ── Turnkey embedded wallets (passkey / email login) ─────────────────
# Get both from the Turnkey dashboard:
#   Organization ID      -> top-right account menu / Organization settings
#   Auth Proxy Config ID -> Embedded Wallets > Configuration (after enabling auth methods)
# Until BOTH are set, the app falls back to normal wallet connect (nothing breaks).
# NEXT_PUBLIC_TURNKEY_ORGANIZATION_ID=
# NEXT_PUBLIC_TURNKEY_AUTH_PROXY_CONFIG_ID=

# Optional: Discord/Slack/Make webhook for product events (server only)
# TRACTION_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── Admin traction dashboard (/admin) ────────────────────────────────
# Required in production (server-only — never NEXT_PUBLIC_):
# ADMIN_ACCESS_CODE=long-random-secret
# Dev default if unset: gloam-dev-admin
# If cookies fail on a weird HTTPS setup: ADMIN_COOKIE_INSECURE=true
#
# Durable product-event store (recommended free Upstash Redis):
# UPSTASH_REDIS_REST_URL=https://….upstash.io
# UPSTASH_REDIS_REST_TOKEN=…
