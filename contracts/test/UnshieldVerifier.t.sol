pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {UnshieldVerifier} from "../src/verifiers/UnshieldVerifier.sol";
import {UnshieldIVerifier} from "../src/verifiers/UnshieldIVerifier.sol";

/**
 * @dev Proof from the real Poseidon unshield circuit (circuits/build/real-input.json),
 *      regenerated on the pot16 dev ceremony after the C2 range-check hardening.
 *      Constraints: commitment, nullifier, Merkle path, amount < 2^128.
 */
contract UnshieldVerifierTest is Test {
    function test_real_poseidon_unshield_proof() public {
        UnshieldVerifier v = new UnshieldVerifier();

        uint256[2] memory a = [
            6957634454184109021678114444733524918042004519382135232440347764408400209238,
            11907590611510504133919552265477234176969003254081885100204008656767523539196
        ];
        // snarkjs soliditycalldata already emits G2 in verifier order; keep a swap fallback.
        uint256[2][2] memory b = [
            [
                12074783442507916633665182906111838295327766373230105789758870116418853661786,
                19673558567803714857983365441418227075419614852577444669868838041523053822495
            ],
            [
                14345503577131882347105010025369547760188533575101097022140360378203860768985,
                19277946504698722565498037945482598261293101185291893033191136039510096573580
            ]
        ];
        uint256[2] memory c = [
            1286191535724976993115868645733440518664215538340370499605925468686013731076,
            11746696505189778215652626326845383882865623404423651651334365119807194577109
        ];
        uint256[5] memory pub = [
            13234193652734635164697424209615330599412255191967788575267034634808796923137,
            1945704986784996205275124157419427994886512646982192210318468338970744312245,
            0,
            1000000000000000,
            1288467190840644149448244075784839353812473341992
        ];

        bool ok = v.verifyProof(a, b, c, pub);
        if (!ok) {
            // try unswapped b
            uint256[2][2] memory b2 = [
                [
                    19673558567803714857983365441418227075419614852577444669868838041523053822495,
                    12074783442507916633665182906111838295327766373230105789758870116418853661786
                ],
                [
                    19277946504698722565498037945482598261293101185291893033191136039510096573580,
                    14345503577131882347105010025369547760188533575101097022140360378203860768985
                ]
            ];
            ok = v.verifyProof(a, b2, c, pub);
            b = b2;
        }
        assertTrue(ok, "real unshield groth16 proof must verify");

        UnshieldIVerifier adapter = new UnshieldIVerifier(v);
        bytes memory proof = abi.encode(a, b, c);
        uint256[] memory inputs = new uint256[](5);
        for (uint256 i = 0; i < 5; i++) inputs[i] = pub[i];
        assertTrue(adapter.verify(proof, inputs));
    }

    function test_tampered_public_input_fails() public {
        UnshieldVerifier v = new UnshieldVerifier();
        uint256[2] memory a = [
            6957634454184109021678114444733524918042004519382135232440347764408400209238,
            11907590611510504133919552265477234176969003254081885100204008656767523539196
        ];
        uint256[2][2] memory b = [
            [
                12074783442507916633665182906111838295327766373230105789758870116418853661786,
                19673558567803714857983365441418227075419614852577444669868838041523053822495
            ],
            [
                14345503577131882347105010025369547760188533575101097022140360378203860768985,
                19277946504698722565498037945482598261293101185291893033191136039510096573580
            ]
        ];
        uint256[2] memory c = [
            1286191535724976993115868645733440518664215538340370499605925468686013731076,
            11746696505189778215652626326845383882865623404423651651334365119807194577109
        ];
        // wrong amount
        uint256[5] memory pub = [
            13234193652734635164697424209615330599412255191967788575267034634808796923137,
            1945704986784996205275124157419427994886512646982192210318468338970744312245,
            0,
            999,
            1288467190840644149448244075784839353812473341992
        ];
        uint256[2][2] memory b2 = [
            [
                19673558567803714857983365441418227075419614852577444669868838041523053822495,
                12074783442507916633665182906111838295327766373230105789758870116418853661786
            ],
            [
                19277946504698722565498037945482598261293101185291893033191136039510096573580,
                14345503577131882347105010025369547760188533575101097022140360378203860768985
            ]
        ];
        assertFalse(v.verifyProof(a, b, c, pub));
        assertFalse(v.verifyProof(a, b2, c, pub));
    }
}
