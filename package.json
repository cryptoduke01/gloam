{
  "name": "gloam",
  "private": true,
  "version": "0.1.0",
  "description": "The private-execution layer for Robinhood Chain: shielded balances, private transfers, and private trades that apps and agents plug into.",
  "scripts": {
    "dev": "pnpm --filter @gloam/app dev",
    "dev:app": "pnpm --filter @gloam/app dev",
    "dev:docs": "pnpm --filter @gloam/docs dev",
    "build": "pnpm --filter @gloam/app build && pnpm --filter @gloam/docs build",
    "build:app": "pnpm --filter @gloam/app build",
    "build:docs": "pnpm --filter @gloam/docs build",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "smoke": "pnpm --filter @gloam/app smoke",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.3"
}
