{
  "name": "@gloam/sdk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Gloam SDK — shielded balances, private transfers, and private trades on Robinhood Chain. The private path other apps and agents plug into.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node test/rates.selftest.mjs"
  },
  "dependencies": {
    "viem": "^2.55.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
