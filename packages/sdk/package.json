{
  "name": "@gloam/sdk",
  "version": "0.0.1",
  "type": "module",
  "description": "Gloam SDK — shielded balances, private payments, and selective disclosure on Robinhood Chain. The private path other apps and agents plug into.",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node test/rates.selftest.mjs && node test/note.selftest.mjs && node test/witness.selftest.mjs && node test/intents.selftest.mjs"
  },
  "dependencies": {
    "viem": "^2.55.2",
    "circomlibjs": "0.1.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "snarkjs": "^0.7.5"
  },
  "peerDependencies": {
    "snarkjs": "*"
  },
  "peerDependenciesMeta": {
    "snarkjs": {
      "optional": true
    }
  }
}
