# Copy to .env (or set these in the agent's environment).
# Your GAME API key (from the Virtuals console).
GAME_API_KEY=

# Gloam network: base (Base Sepolia, testnet) or robinhood-mainnet (mainnet, USDG).
GLOAM_NETWORK=base
# The agent's wallet key: holds public funds and signs deposits. Keep it in the agent's environment only.
GLOAM_AGENT_PRIVATE_KEY=
# Per-asset limits. limits.example.json is for base (USDC and ETH on Base Sepolia);
# on robinhood-mainnet name USDG instead. Without limits nothing moves, and limits
# in code plus a file are refused, so src/example.ts uses its own only when this is unset.
GLOAM_LIMITS_FILE=./limits.example.json
# Optional: an RPC of your own. If it carries an API key, the plugin keeps it out of every message.
# GLOAM_RPC_URL=
# Optional: a separate key for the encrypted note store (openssl rand -hex 32). Back it up.
# GLOAM_NOTE_KEY=
# Optional: names the store, the spending log and the limits entry.
# GLOAM_AGENT_ID=default
# Optional: "wallet" sends private payments from the agent's own wallet instead of the Gloam relay.
# GLOAM_SUBMIT=relay
