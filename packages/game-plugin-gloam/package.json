{
  "name": "@gloamtrade/game-plugin-gloam",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "description": "Gloam plugin for the GAME framework: private stablecoin payments for Virtuals agents on Base and Robinhood Chain, under per-asset spending limits the agent cannot lift.",
  "license": "MIT",
  "homepage": "https://gloam.trade/docs/agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cryptoduke01/gloam.git",
    "directory": "packages/game-plugin-gloam"
  },
  "bugs": {
    "url": "https://github.com/cryptoduke01/gloam/issues"
  },
  "keywords": [
    "gloam",
    "game",
    "virtuals",
    "virtuals-protocol",
    "game-plugin",
    "acp",
    "ai-agents",
    "agent-payments",
    "stablecoin",
    "privacy",
    "zero-knowledge",
    "spending-limits",
    "base",
    "robinhood-chain"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "plugin_metadata.yml",
    "limits.example.json",
    "env.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-vkeys.mjs",
    "prepack": "npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "tsc --noEmit -p tsconfig.test.json && tsx --test test/*.test.mts",
    "test:fork": "tsx --test --test-concurrency=1 test/fork.test.mts test/fork.money.test.mts test/fork.retry.test.mts test/fork.feerise.test.mts",
    "example": "tsx src/example.ts"
  },
  "dependencies": {
    "@gloamtrade/sdk": "workspace:^",
    "@virtuals-protocol/game": "^0.1.14",
    "circomlibjs": "0.1.7",
    "snarkjs": "^0.7.5",
    "viem": "2.55.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4",
    "typescript": "^5"
  }
}
